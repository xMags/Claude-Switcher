<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ClaudeSwitcher.ProfileEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <StackPanel Width="360" Spacing="16">
        <TextBox
            x:Name="NameBox"
            Header="Name"
            MaxLength="40"
            PlaceholderText="Work"
            TextChanged="OnNameChanged" />
        <TextBox
            x:Name="NoteBox"
            Header="Note (optional)"
            MaxLength="80"
            PlaceholderText="Which account this is, for example you@work.com" />
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Colour" />
            <GridView
                x:Name="ColorGrid"
                Padding="0"
                AutomationProperties.Name="Profile colour"
                SelectionMode="Single">
                <!-- Compact containers so all eight swatches fit on one row. -->
                <GridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                        <Setter Property="MinWidth" Value="40" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>
        </StackPanel>
        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
