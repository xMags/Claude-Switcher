<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClaudeSwitcher.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeSwitcher"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="ProfileCardTemplate" x:DataType="local:ProfileCardViewModel">
            <Grid
                Height="212"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Rectangle Grid.Row="0">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{x:Bind AccentColor, Mode=OneWay}" />
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel
                    Grid.Row="1"
                    Padding="16,12,16,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <!-- Folder with a lock: a sealed-off data folder per account. -->
                    <Grid Width="44" Height="40" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <FontIcon FontSize="34" Glyph="&#xE8B7;">
                            <FontIcon.Foreground>
                                <SolidColorBrush Color="{x:Bind AccentColor, Mode=OneWay}" />
                            </FontIcon.Foreground>
                        </FontIcon>
                        <Border
                            Width="20"
                            Height="20"
                            Margin="0,0,-2,-2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="10">
                            <FontIcon FontSize="12" Glyph="&#xE72E;" />
                        </Border>
                    </Grid>
                    <TextBlock
                        MaxWidth="200"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        MaxWidth="200"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Note, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind RunningVisibility, Mode=OneWay}">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Running" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2" Padding="12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="OnPrimaryClick"
                        Content="{x:Bind PrimaryActionText, Mode=OneWay}"
                        IsEnabled="{x:Bind CanLaunch, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Tag="{x:Bind Id}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="More options"
                        ToolTipService.ToolTip="More options">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Click="OnEditClick"
                                    Tag="{x:Bind Id}"
                                    Text="Edit…"
                                    Visibility="{x:Bind ManageVisibility}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnShortcutClick"
                                    Tag="{x:Bind Id}"
                                    Text="Create desktop shortcut"
                                    Visibility="{x:Bind ManageVisibility}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnStartMenuShortcutClick"
                                    Tag="{x:Bind Id}"
                                    Text="Add to Start menu"
                                    Visibility="{x:Bind ManageVisibility}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnOpenFolderClick" Tag="{x:Bind Id}" Text="Open data folder">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator Visibility="{x:Bind ManageVisibility}" />
                                <MenuFlyoutItem
                                    Click="OnDeleteClick"
                                    Tag="{x:Bind Id}"
                                    Text="Delete…"
                                    Visibility="{x:Bind ManageVisibility}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1040"
            Padding="24,8,24,32"
            Spacing="16">

            <!-- Header, after the concept: the switcher above the accounts. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="48"
                    Height="48"
                    VerticalAlignment="Center"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <FontIcon FontSize="22" Glyph="&#xE7F4;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Account Switcher" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Add profile"
                    Click="OnAddClick"
                    IsEnabled="{x:Bind ViewModel.CanAddProfiles, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add profile" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}"
                Closed="OnMessageClosed"
                IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" />

            <InfoBar
                Title="Signing in to a new profile"
                Closed="OnSignInHintClosed"
                IsOpen="{x:Bind ViewModel.IsSignInHintOpen, Mode=OneWay}"
                Message="Sign in with the code Claude emails you. Sign-in links and Google sign-in open in the Default Claude window, not in the profile you are setting up."
                Severity="Informational" />

            <ItemsRepeater
                ItemTemplate="{StaticResource ProfileCardTemplate}"
                ItemsSource="{x:Bind ViewModel.Cards}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemHeight="212"
                        MinItemWidth="220"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Add a profile for each Claude account you use. Each one opens Claude Desktop with its own separate session."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.EmptyHintVisibility, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
