<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClaudeSwitcher.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <!-- A settings row in the style of Windows Settings: icon, text, control. -->
        <Style x:Key="SettingCardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="SettingSectionStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,16,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1040"
            Padding="24,8,24,32"
            Spacing="4">

            <TextBlock Margin="0,0,0,8" Style="{StaticResource SubtitleTextBlockStyle}" Text="Settings" />

            <InfoBar
                Title="Something went wrong"
                Closed="OnErrorClosed"
                IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                Severity="Error" />

            <TextBlock Style="{StaticResource SettingSectionStyle}" Text="Appearance" />
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE790;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="App theme" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Choose how Claude Switcher looks. Claude Desktop keeps its own theme."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    Grid.Column="2"
                    MinWidth="180"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="App theme"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </ComboBox>
            </Grid>

            <TextBlock Style="{StaticResource SettingSectionStyle}" Text="Startup and tray" />
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE7E8;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Opens Claude Switcher when you sign in. With Close to tray on, it starts in the tray instead of showing a window."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="2"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Start with Windows"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </Grid>
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE8BB;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Close to tray" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="The close button hides the window in the notification area instead of quitting. Click the tray icon to bring it back; right-click it and choose Quit to exit."
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="2"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Close to tray"
                    IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
