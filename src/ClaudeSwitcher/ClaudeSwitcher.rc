// Gives ClaudeSwitcher.exe its icon in Explorer, the taskbar and Alt+Tab.
// Windows uses the lowest-numbered icon group, so this stays at 1.
#include <windows.h>

1 ICON "Assets\\AppIcon.ico"

// APP_VERSION_COMMAS and APP_VERSION_TEXT come from build\Version.props.
#ifndef APP_VERSION_COMMAS
#define APP_VERSION_COMMAS 0,0,0,0
#define APP_VERSION_TEXT "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_COMMAS
PRODUCTVERSION APP_VERSION_COMMAS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Last Projects"
            VALUE "FileDescription", "Claude Switcher"
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "InternalName", "ClaudeSwitcher"
            VALUE "LegalCopyright", "Copyright (c) 2026 Debashis Das. Source available under the Last Projects License 1.0."
            VALUE "OriginalFilename", "ClaudeSwitcher.exe"
            VALUE "ProductName", "Claude Switcher"
            VALUE "ProductVersion", APP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
